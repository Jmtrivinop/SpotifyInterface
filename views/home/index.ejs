<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <title>Document</title>
</head>
<body>
  <nav class="navbar is-dark" role="navigation" aria-label="main navigation">
    <div class="navbar-menu is-flex is-justify-content-space-between is-align-items-center px-5" style="width: 100%;">
      
      <!-- Sección izquierda (Logo) -->
      <div class="navbar-start is-flex is-align-items-center">
        <a href="#" class="navbar-logo">
          <img src="/assets/icons/Logo.png" alt="Logo">
        </a>
      </div>

      <!-- Sección central (Home + Barra de búsqueda) -->
      <div class="navbar-item is-flex is-align-items-center is-justify-content-center" style="flex-grow: 1;">
        <a class="icon has-text-white mx-3" title="Inicio">
          <i class="fas fa-home fa-lg"></i>
        </a>

        <!-- Ícono de búsqueda en móviles -->
        <div class="is-hidden-tablet">
          <a class="icon has-text-white mx-3" id="mobile-search-icon" title="Buscar">
            <i class="fas fa-search fa-lg"></i>
          </a>
        </div>

        <!-- Barra de búsqueda en pantallas grandes -->
        <div class="control has-icons-left is-hidden-mobile">
          <input class="input is-rounded has-background-dark has-text-white" type="text" placeholder="¿Qué deseas ver?" />
          <span class="icon is-left has-text-grey-light">
            <i class="fas fa-search"></i>
          </span>
        </div>
      </div>

      <!-- Sección derecha (Notificaciones, Amigos, Perfil) -->
      <div class="navbar-end is-flex is-align-items-center">
        <div class="is-hidden-mobile is-flex">
            <!-- Notificaciones -->
            <div class="dropdown is-right">
                <a class="icon has-text-white mx-3 dropdown-trigger" title="Notificaciones">
                    <i class="fas fa-bell fa-lg"></i>
                </a>
                <div class="dropdown-menu" role="menu">
                    <div class="dropdown-content">
                        <a class="dropdown-item">Ver notificaciones</a>
                        <a class="dropdown-item">Configuración</a>
                    </div>
                </div>
            </div>
    
            <!-- Amigos -->
            <div class="dropdown is-right">
                <a class="icon has-text-white mx-3 dropdown-trigger" title="Amigos">
                    <i class="fas fa-users fa-lg"></i>
                </a>
                <div class="dropdown-menu" role="menu">
                    <div class="dropdown-content">
                        <a class="dropdown-item">Ver amigos</a>
                        <a class="dropdown-item">Solicitudes de amistad</a>
                    </div>
                </div>
            </div>
    
            <!-- Perfil -->
            <div class="dropdown is-right">
                <a class="navbar-item mx-3 dropdown-trigger" title="Perfil">
                    <i class="fa-solid fa-user fa-lg"></i>
                </a>
                <div class="dropdown-menu" role="menu">
                    <div class="dropdown-content">
                        <a class="dropdown-item">Ver perfil</a>
                        <a class="dropdown-item">Cerrar sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    


        <!-- Menú desplegable en móviles -->
    <div class="dropdown is-right is-hidden-tablet" id="mobile-dropdown">
      <div class="dropdown-trigger">
        <button class="button is-dark" id="dropdown-button" aria-haspopup="true" aria-controls="dropdown-menu">
          <span>Menú</span>
          <span class="icon is-small">
            <i class="fas fa-angle-down"></i>
          </span>
        </button>
      </div>

      <div class="dropdown-menu" id="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <!-- Notificaciones -->
          <div class="dropdown is-right">
            <a class="dropdown-item has-text-black is-flex is-align-items-center dropdown-trigger">
              <i class="fas fa-bell mr-2"></i> Notificaciones
            </a>
            <div class="dropdown-menu" role="menu">
              <div class="dropdown-content">
                <a class="dropdown-item">Ver notificaciones</a>
                <a class="dropdown-item">Configuración</a>
              </div>
            </div>
          </div>

          <!-- Amigos -->
          <div class="dropdown is-right">
            <a class="dropdown-item has-text-black is-flex is-align-items-center dropdown-trigger">
              <i class="fas fa-users mr-2"></i> Amigos
            </a>
            <div class="dropdown-menu" role="menu">
              <div class="dropdown-content">
                <a class="dropdown-item">Ver amigos</a>
                <a class="dropdown-item">Solicitudes de amistad</a>
              </div>
            </div>
          </div>

          <!-- Perfil -->
          <div class="dropdown is-right">
            <a class="dropdown-item has-text-black is-flex is-align-items-center dropdown-trigger">
              <i class="fa-solid fa-user mr-2"></i> Perfil
            </a>
            <div class="dropdown-menu" role="menu">
              <div class="dropdown-content">
                <a class="dropdown-item">Ver perfil</a>
                <a class="dropdown-item">Cerrar sesión</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>
    </div>

    <!-- Barra de búsqueda en móviles (oculta por defecto) -->
    <div class="is-hidden px-5 py-3" id="mobile-search">
      <div class="control has-icons-left">
        <input class="input is-rounded has-background-dark has-text-white" type="text" placeholder="¿Qué deseas ver?" id="mobile-search-input" />
        <span class="icon is-left has-text-grey-light">
          <i class="fas fa-search"></i>
        </span>
      </div>
    </div>
</nav>

  <main class="columns" style="margin: 0;">
    
    <section class="column is-4 is-narrow-widescreen" id="section-aside-menu">

      <div class="box aside-menu">
          
        <nav class="navbar">

          <div class="navbar-brand">
            <a class="navbar-item">
              <i class="fa-solid fa-book"></i>
              <span class="icon-text">
                

                <span>Biblioteca</span>
              </span>
            </a>
          </div>

          <div class="navbar-menu">

            <div class="navbar-end">

              <a href="" class="navbar-item">

                <i class="fa-solid fa-plus" style="color: #ffffff;"></i>

              </a>

              <a href="" class="navbar-item">

                <i class="fa-solid fa-arrow-right" style="color: #fcfcfc;"></i>
              </a>

            </div>

          </div>

        </nav>

        <div class="field is-grouped">
          <p class="control">
            <button class="button is-rounded is-small is-responsive">Playlist</button>
          </p>
          <p class="control">
            <button class="button is-rounded is-small is-responsive">Podcast y programas</button>
          </p>
          <p class="control">
            <button class="button is-rounded is-small is-responsive">Albumes</button>
          </p>
          <p class="control">
            <button class="button is-rounded is-small is-responsive">Artistas</button>
          </p>
        </div>


        <div>

          <aside class="menu">
            <p class="menu-label">Menu</p>
            <ul class="menu-list">
              <li><a class="menu-item is-active">Home</a></li>
              <li><a class="menu-item">Tendencias</a></li>
              <li><a class="menu-item">Mis videos</a></li>
              <li><a class="menu-item">Playlist</a></li>
            </ul>
          </aside>
  
        </div>

      </div>

    </section>

    <section class="column is-10">

      <div class="box main-content">

        <section class="video-container">

          <div id="player"></div>

        </section>

        <section class="container is-flex is-flex-direction-column is-justify-content-center carrusel-container">
          
          <div class="box">
            <div class="block carrusel">

            </div>
          </div>

        </section>

        <section class="container video-player-container">

          <div class="box video-player">
    
            <div class="left-player">

              <div class="video-info">

                <figure class="image is-48x48">
                  <img class="is-rounded reproductor-img" src="https://bulma.io/assets/images/placeholders/128x128.png" />
                </figure>

                <div class="video-info-text is-size-6 has-text-grey">
                  <p class="reproductor-title">Titulo del video</p>
                  <p class="reproductor-channel">Descripción del video</p>
                </div>

              </div>

            </div>

            <div class="controllers-player">

              <div class="controllers-container">

                <span class="icon">
                  <i class="atras fa-solid fa-backward-step"></i>
                </span>

                <span class="icon">
                  <i class="play fa-solid fa-play fa-lg"></i>
                </span>

                <span class="icon">
                  <i class="siguiente fa-solid fa-forward-step"></i>
                </span>

              </div>

            </div>

            <div class="rigth-player">

            </div>
    
          </div>
    
        </section>

      </div>

    </section>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/home.js"></script>
  <script src="js/header.js"></script>
</body>
</html>